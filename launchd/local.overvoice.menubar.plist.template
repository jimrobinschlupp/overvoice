<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.overvoice.menubar</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/Overvoice</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Deliberately not KeepAlive: choosing Quit from the menu should actually
       quit it until the next login, not have it respawn instantly. -->
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
